{
  "name": "latent-protocol-vscode",
  "displayName": "Latent Protocol — Sponsored Spinner",
  "description": "Earn USDC while your coding agent thinks. Shows a labeled sponsor line in the agent's spinner/status area (Cursor, VS Code, Claude Code, Codex).",
  "version": "0.5.8",
  "publisher": "latent-protocol",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/enzoonchain/latent-market.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "latent.enable",
        "title": "Latent: Enable sponsored spinner"
      },
      {
        "command": "latent.disable",
        "title": "Latent: Disable sponsored spinner"
      },
      {
        "command": "latent.patchAgentBundles",
        "title": "Latent: Patch agent spinner (in-agent ads, advanced)"
      },
      {
        "command": "latent.restore",
        "title": "Latent: Restore agent bundles (undo patch)"
      },
      {
        "command": "latent.openPanel",
        "title": "Latent: Open panel"
      },
      {
        "command": "latent.openSponsor",
        "title": "Latent: Open sponsored link"
      },
      {
        "command": "latent.copySponsor",
        "title": "Latent: Copy sponsored link"
      },
      {
        "command": "latent.diagnose",
        "title": "Latent: Diagnose"
      },
      {
        "command": "latent.showEarnings",
        "title": "Latent: Show earnings"
      },
      {
        "command": "latent.checkConflicts",
        "title": "Latent: Check for hook conflicts"
      },
      {
        "command": "latent.installCliHook",
        "title": "Latent: Install Claude CLI hook"
      },
      {
        "command": "latent.removeCliHook",
        "title": "Latent: Remove Claude CLI hook"
      }
    ],
    "configuration": {
      "title": "Latent Protocol",
      "properties": {
        "latent.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Master on/off for the sponsored spinner."
        },
        "latent.wallet": {
          "type": "string",
          "default": "",
          "description": "EVM wallet for earnings. Falls back to ~/.latent-protocol/config.json."
        },
        "latent.server": {
          "type": "string",
          "default": "https://api.latentprotocol.xyz",
          "description": "Latent ad server base URL."
        },
        "latent.patchAgentBundles": {
          "type": "boolean",
          "default": false,
          "description": "Advanced/invasive: runtime-patch the installed Claude Code / Codex extension webview bundle to render the sponsor line inside its native spinner. Reversible (pristine backup + Latent: Restore), but it modifies a third-party extension and relaxes its webview CSP to reach the local loopback. Off by default — the non-invasive status-bar + sidebar fallback is always available."
        },
        "latent.rotateSeconds": {
          "type": "number",
          "default": 10,
          "description": "How often the shown sponsor line rotates."
        },
        "latent.sponsorSurface": {
          "type": "string",
          "enum": ["statusbar", "overlay"],
          "default": "statusbar",
          "description": "Unused. The sponsor line is the floating composer line. The status bar shows Latent Menu and the balance."
        },
        "latent.cursorOverlay": {
          "type": "boolean",
          "default": false,
          "description": "Unused. Sponsor placement is latent.sponsorSurface."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "latent",
          "title": "Latent",
          "icon": "media/latent.svg"
        }
      ]
    },
    "views": {
      "latent": [
        {
          "id": "latentSponsor",
          "name": "Latent",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "vscode:uninstall": "node ./dist/uninstall.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
