{
  "name": "latent-protocol-vscode",
  "displayName": "Latent Ads Market (Testnet) - Monetize the attention of Agents",
  "description": "Testnet (Base Sepolia). A labeled sponsor line while your coding agent works, and your USDC balance in the Latent panel.",
  "version": "0.5.14",
  "preview": true,
  "icon": "media/icon.png",
  "publisher": "latentprotocol",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/enzoonchain/latent-market.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "latent.enable",
        "title": "Latent Ads: Enable sponsor line"
      },
      {
        "command": "latent.disable",
        "title": "Latent Ads: Disable sponsor line"
      },
      {
        "command": "latent.patchAgentBundles",
        "title": "Latent Ads: Patch agent bundles (advanced)"
      },
      {
        "command": "latent.restore",
        "title": "Latent Ads: Restore agent bundles"
      },
      {
        "command": "latent.openPanel",
        "title": "Latent Ads: Open panel"
      },
      {
        "command": "latent.openSponsor",
        "title": "Latent Ads: Open sponsored link"
      },
      {
        "command": "latent.copySponsor",
        "title": "Latent Ads: Copy sponsored link"
      },
      {
        "command": "latent.diagnose",
        "title": "Latent Ads: Diagnose"
      },
      {
        "command": "latent.showEarnings",
        "title": "Latent Ads: Show earnings"
      },
      {
        "command": "latent.checkConflicts",
        "title": "Latent Ads: Check for hook conflicts"
      },
      {
        "command": "latent.installCliHook",
        "title": "Latent Ads: Install Claude CLI hook"
      },
      {
        "command": "latent.removeCliHook",
        "title": "Latent Ads: Remove Claude CLI hook"
      }
    ],
    "configuration": {
      "title": "Latent Ads Market (Testnet)",
      "properties": {
        "latent.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Master on/off for the sponsor line."
        },
        "latent.wallet": {
          "type": "string",
          "default": "",
          "description": "EVM wallet for earnings. Falls back to ~/.latent-protocol/config.json."
        },
        "latent.server": {
          "type": "string",
          "default": "https://api.latentprotocol.xyz",
          "description": "Latent ad server base URL."
        },
        "latent.patchAgentBundles": {
          "type": "boolean",
          "default": false,
          "description": "Advanced: patch the installed Claude Code or Codex webview so a sponsor line can sit under its thinking row. Reversible (pristine backup + Latent Ads: Restore). It modifies a third-party extension and relaxes that webview's CSP for the local loopback only. Off by default. The floating composer line does not need this."
        },
        "latent.rotateSeconds": {
          "type": "number",
          "default": 10,
          "description": "How often the shown sponsor line rotates."
        },
        "latent.sponsorSurface": {
          "type": "string",
          "enum": ["statusbar", "overlay"],
          "default": "statusbar",
          "description": "Unused. The sponsor line is the floating composer line. The status bar shows Latent Menu and the balance."
        },
        "latent.cursorOverlay": {
          "type": "boolean",
          "default": false,
          "description": "Unused. Sponsor placement is latent.sponsorSurface."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "latent",
          "title": "Latent Ads (Testnet)",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "latent": [
        {
          "id": "latentSponsor",
          "name": "Latent Ads (Testnet)",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "vscode:uninstall": "node ./dist/uninstall.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
