{
  "name": "latent-market",
  "version": "0.1.3",
  "description": "Latent Market — one-line installer for Claude Code + Hermes sponsored ads",
  "type": "module",
  "bin": {
    "latent": "./dist/index.js",
    "latent-protocol": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/claude",
    "templates"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node scripts/bundle.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.7.0",
    "viem": "^2.21.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/enzoonchain/latent-market.git",
    "directory": "cli"
  },
  "license": "Apache-2.0",
  "keywords": [
    "latent-market",
    "latent-protocol",
    "claude-code",
    "hermes",
    "x402",
    "ads"
  ]
}
