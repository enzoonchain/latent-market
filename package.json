{
  "name": "latent-protocol",
  "version": "0.1.2",
  "private": true,
  "description": "Latent Protocol (retired CLI) \u2014 use LatentCode, latent-opencode or the VS Code extension",
  "type": "module",
  "bin": {
    "latent": "./cli/dist/index.js",
    "latent-protocol": "./cli/dist/index.js"
  },
  "files": [
    "cli/dist",
    "cli/templates"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "npm --prefix cli install --include=dev && npm --prefix cli run build",
    "build": "npm --prefix cli run build"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/enzoonchain/latent-protocol.git"
  },
  "license": "Apache-2.0"
}
